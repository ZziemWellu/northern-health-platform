      <bind nodeset="/data/data/__age_months" type="string" calculate=" /data/age_months "/>
      <bind nodeset="/data/data/__severity" type="string" calculate=" /data/r_severity "/>
      <bind nodeset="/data/data/__danger_signs" type="string" calculate=" /data/r_reasons "/>
      <bind nodeset="/data/data/__treatments" type="string" calculate=" /data/r_treatments "/>
      <bind nodeset="/data/data/__rdt" type="string" calculate=" /data/tests/rdt "/>
      <bind nodeset="/data/data/meta/__patient_uuid" type="string" calculate="../../../inputs/contact/_id"/>
