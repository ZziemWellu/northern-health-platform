{
  "name": "northern-health-cht-app",
  "version": "0.1.0",
  "private": true,
  "description": "Northern Ghana Community Health Platform - CHT app configuration (based on cht-core 5.3.1 config/default)",
  "license": "AGPL-3.0-only",
  "scripts": {
    "test": "cross-env TZ=Africa/Accra mocha --recursive --reporter spec test --timeout 20000",
    "test-tasks": "cross-env TZ=Africa/Accra mocha --reporter spec test/tasks/*.spec.js --timeout 20000",
    "test-forms": "cross-env TZ=Africa/Accra mocha --reporter spec \"test/forms/**/*.spec.js\" --timeout 20000",
    "compile": "cht --no-check compile-app-settings",
    "upload": "cht --url=%CHT_URL% --accept-self-signed-certs"
  },
  "devDependencies": {
    "@medic/eslint-config": "1.1.0",
    "chai": "^4.3.8",
    "chai-like": "^1.1.1",
    "chai-things": "^0.2.0",
    "cht-conf": "^6.6.1",
    "cht-conf-test-harness": "5.0.4",
    "cross-env": "^7.0.3",
    "eslint-plugin-json": "4.0.1",
    "mocha": "^11.7.4",
    "moment": "^2.29.1",
    "sinon": "^21.0.1"
  }
}
